// Arquivo de teste para a linguagem SMKL

html(lang="pt-BR") {
  head {
    |meta(charset="UTF-8")|
    |meta(name="viewport", content="width=device-width, initial-scale=1.0")|
    title { "SMKL - Teste de Transpilação" }

    style {
      body {
        font-family: system-ui, sans-serif;
        background-color: #1a1a1a;
        color: #f0f0f0;
        margin: 0;
        padding: 2rem;
      }
      .card {
        background-color: #2a2a2a;
        border-radius: 8px;
        padding: 1.5rem;
        max-width: 500px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
      }
      button {
        background-color: #007acc;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
      }
      button:hover {
        background-color: #005999;
      }
    }
  }

  body {
    div(class="card", id="main-container") {
      h1 { "Compilador SMKL" }
      p { "Este HTML foi gerado com sucesso a partir de um arquivo .smkl em Rust!" }

      |hr|

      div(class="actions") {
        button(id="btn-click", onclick="testar()") { "Clique para Testar JS" }
      }
    }

    script {
      function testar() {
        console.log("JavaScript executado diretamente do bloco script!");
        alert("SMKL -> HTML transpilação concluída!");
      }
    }
  }
}
